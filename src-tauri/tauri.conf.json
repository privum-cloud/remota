{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remota",
  "version": "0.1.8",
  "identifier": "cloud.privum.remota",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remota",
        "width": 1100,
        "height": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRkM0MTA3OEJCQThCNDMKUldSRGk3cUxCMEg4UDJqUkFWV21uWEwyOWtEVjVvcmpicFFsNEc3bFQ4cHhrN1lFd3dsRk1ocVQK",
      "endpoints": [
        "https://github.com/privum-cloud/remota/releases/latest/download/latest.json"
      ]
    }
  }
}
